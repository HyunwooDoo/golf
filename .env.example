# 대표 홈페이지 주소 (https:// 포함, 경로 없이 입력).
# 비워두면 https://dooyunkon.pro 사용. 프리뷰 도메인은 대표 주소로 사용하지 않습니다.
NEXT_PUBLIC_SITE_URL=

# 검색엔진 소유확인 태그의 content 값만 입력 (설정 후 재빌드/재배포)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<meta name="google-site-verification" content="yXeNvfdHhLcOzzh6e0JDuASEejPj5ApqSU3e9McPKEQ" />
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=34f5669808583aba938cb1e6d5eec17b5ef4444d


# 카카오톡 1:1 상담 링크
# 채널 홈 URL(http://pf.kakao.com/_xxxxx, 뒤에 /chat 붙이면 채팅 바로 열림)
# 또는 오픈채팅방 URL(https://open.kakao.com/o/xxxxxxx) 모두 사용 가능합니다.
# 비워두면 코드에 있는 기본 오픈채팅 링크로 연결됩니다.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 카카오맵 길찾기 링크
NEXT_PUBLIC_KAKAO_MAP_URL=

# 카카오맵 JavaScript SDK 키
# 카카오디벨로퍼스 → 앱 → 플랫폼 키 → JavaScript 키
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 연습장 정보 (비워두면 코드의 기본값을 사용합니다)
NEXT_PUBLIC_LESSON_PHONE=010-7434-4208
NEXT_PUBLIC_LESSON_ADDRESS=서울특별시 도봉구 마들로 598 서울문화고등학교 교내
NEXT_PUBLIC_CONSULTATION_HOURS=

# 외부 채널
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yunkondo
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_NAVER_PLACE_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# 문의 폼 접수 경로 (하나만 설정해도 동작합니다)
# 1) 웹훅: 슬랙 / 디스코드 / Make / Zapier 등에서 발급한 주소
CONTACT_WEBHOOK_URL=
# 2) 이메일: https://resend.com 에서 API 키 발급 후 사용
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
